PORT=5000

# Leave empty to use the built-in local dev MongoDB (stored in server/.mongo-data).
# For production use MongoDB Atlas, e.g. mongodb+srv://user:pass@cluster.mongodb.net/biswa-portfolio
MONGO_URI=

# Long random string used to sign admin sessions.
JWT_SECRET=change-me-to-a-long-random-string

# Admin panel login (/admin). The password here is always the source of truth.
ADMIN_EMAIL=admin@biswa.dev
ADMIN_PASSWORD=change-me

# AI assistant (Google Gemini). Optional: the key and model can also be set from Admin → AI assistant,
# which overrides these. Without any key the "Ask AI" button is hidden.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Comma-separated allowed origins in production (leave empty in dev).
CLIENT_ORIGIN=
